# Скопируй в .env и заполни реальными значениями (файл .env в .gitignore).

# Telegram — свой официальный API-доступ, получить на https://my.telegram.org
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
TELEGRAM_PHONE=+00000000000

# Anthropic — ключ для ступени 2 фильтра (классификация + извлечение полей)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5-20251001

# Google Sheets — сервисный аккаунт с доступом на редактирование таблицы
GOOGLE_SERVICE_ACCOUNT_FILE=data/google_service_account.json
GOOGLE_SHEET_ID=
GOOGLE_WORKSHEET_NAME=Карточки

# Бизнес-правила из ТЗ
CARDS_PER_RUN=50
DEPTH_MONTHS=6
